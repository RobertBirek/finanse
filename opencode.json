{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "personal-advisor",
  "instructions": ["AGENTS.md"],
  "shell": "/bin/bash",
  "permission": {
    "edit": "allow",
    "bash": {
      "docker *": "allow",
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pip3 *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "sqlite3 /docker/npmplus/*": "allow",
      "curl *": "allow",
      "make *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "/docker/finanse/**": "allow",
      "/docker/npmplus/**": "allow",
      "/tmp/**": "allow",
      "*": "ask"
    }
  }
}
