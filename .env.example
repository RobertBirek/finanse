# Copy to /docker/finanse/.env and fill in values
POSTGRES_USER=finanse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finanse
DATABASE_URL=postgresql+asyncpg://finanse:change_me@localhost:5432/finanse
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change_me_to_random_64_chars
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6.1-sol
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REASONING_EFFORT=low
DOCUMENT_TEXT_MODEL=gpt-6.1-terra
DOCUMENT_TEXT_MAX_OUTPUT_TOKENS=2000
DOCUMENT_TEXT_REASONING_EFFORT=none
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# Preferred explicit allowlist. Accepts comma-separated origins or a JSON list.
# TRUSTED_ORIGINS=["https://app.example","https://admin.example"]
TRUSTED_ORIGINS=http://localhost:5173
# Session duration in minutes. Use a deployment-specific positive integer.
SESSION_EXPIRE_MINUTES=10080
# Set false to disable public registration. Production always disables it.
REGISTRATION_ENABLED=true
# Rate limiting is not enabled yet; configure positive integers for the future limiter.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ADVISOR_RATE_LIMIT=30
ADVISOR_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
STIRLING_PDF_URL=http://localhost:8080
# Vision remains disabled until both this infrastructure stop and the database policy are enabled.
FINANCE_CATEGORY_SPLIT_MAX_PARTS=50
# Future-only approved categorization rules. Per-user rules remain OFF until confirmed.
FINANCE_RULE_DESCRIPTION_MAX_CHARS=500
FINANCE_RULE_DISPATCH_BATCH=50
FINANCE_RULE_LEASE_SECONDS=60
FINANCE_RULE_MAX_ATTEMPTS=3
FINANCE_RULE_RETRY_INITIAL_SECONDS=10
FINANCE_RULE_RETRY_LATER_SECONDS=60
FINANCE_RULE_UI_POLL_MS=2000
DOCUMENT_VISION_ENABLED=false
DOCUMENT_VISION_PROVIDER=openai
DOCUMENT_VISION_BASE_URL=https://api.openai.com/v1
DOCUMENT_VISION_MODEL=gpt-6.1-terra
DOCUMENT_VISION_API_KEY=
DOCUMENT_VISION_REASONING_EFFORT=none
DOCUMENT_VISION_PROMPT_VERSION=
DOCUMENT_VISION_SCHEMA_VERSION=
# Finance AI suggestions: separate opt-in and server policy; OFF until separately approved.
FINANCE_SUGGESTIONS_ENABLED=false
FINANCE_SUGGESTIONS_PROVIDER=
FINANCE_SUGGESTIONS_BASE_URL=
FINANCE_SUGGESTIONS_MODEL=
FINANCE_SUGGESTIONS_API_KEY=
FINANCE_SUGGESTIONS_DESCRIPTION_MAX_CHARS=500
FINANCE_SUGGESTIONS_MAX_CATEGORIES=200
FINANCE_SUGGESTIONS_MAX_REQUEST_BYTES=32768
FINANCE_SUGGESTIONS_MAX_OUTPUT_TOKENS=1024
FINANCE_SUGGESTIONS_EXPLANATION_MAX_CHARS=500
FINANCE_SUGGESTIONS_NEW_CATEGORY_MAX_CHARS=80
FINANCE_SUGGESTIONS_DAILY_CALL_LIMIT=5
FINANCE_SUGGESTIONS_TTL_DAYS=7
FINANCE_SUGGESTIONS_MAX_JOB_AGE_HOURS=24
FINANCE_SUGGESTIONS_REVIEW_PAGE_SIZE=20
FINANCE_SUGGESTIONS_TIMEOUT_SECONDS=30
FINANCE_SUGGESTIONS_LEASE_SECONDS=90
FINANCE_SUGGESTIONS_JOB_TIMEOUT_SECONDS=120
FINANCE_SUGGESTIONS_MAX_ATTEMPTS=3
FINANCE_SUGGESTIONS_RETRY_INITIAL_SECONDS=10
FINANCE_SUGGESTIONS_RETRY_LATER_SECONDS=60
FINANCE_SUGGESTIONS_DISPATCH_BATCH=20
FINANCE_SUGGESTIONS_UI_POLL_MS=2000
